{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionaize.local/schemas/provider-catalog.v1.schema.json",
  "title": "fusionAIze Provider Catalog v1.2",
  "description": "Provider catalog with pricing, capabilities, and freshness metadata. v1.1 (additive): adds tier_status and expires_at per-provider fields. v1.2 (additive): adds modalities, image token pricing, free_tier, and evidence metadata. Older consumers ignore unknown fields.",
  "type": "object",
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "fusionaize-provider-catalog version string, e.g. 'fusionaize-provider-catalog/v1.2'. v1, v1.1, and v1.2 are all valid; older consumers ignore unknown fields."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_repo": {
      "type": "string"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "recommended_model": {
            "type": ["string", "null"]
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "track": { "type": "string" },
          "offer_track": { "type": "string" },
          "provider_type": { "type": "string" },
          "auth_modes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tier_status": {
            "type": "string",
            "enum": ["active", "deprecated", "expired", "preview"],
            "description": "v1.1: lifecycle state of this provider tier. Defaults to 'active' when absent."
          },
          "expires_at": {
            "type": "string",
            "format": "date",
            "description": "v1.1: ISO date after which this provider entry should be treated as expired (free tier ends, deprecated, etc.)"
          },
          "volatility": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "evidence_level": {
            "type": "string",
            "enum": ["official", "mixed", "unofficial"]
          },
          "modalities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["text", "vision", "audio", "image_generation", "tool_use", "function_calling", "json_mode"]
            }
          },
          "evidence": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "enum": ["belegt", "plausibel", "unbestaetigt"]
              },
              "source_url": { "type": "string" }
            },
            "additionalProperties": true
          },
          "free_tier": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "request_limit_per_day": { "type": "integer", "minimum": 0 },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          },
          "official_source_url": { "type": "string" },
          "signup_url": { "type": "string" },
          "watch_sources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" },
          "last_reviewed": { "type": "string" },
          "pricing": {
            "type": "object",
            "properties": {
              "source_type": { "type": "string" },
              "source_url": { "type": "string" },
              "refreshed_at": { "type": "string" },
              "freshness_status": {
                "type": "string",
                "enum": ["fresh", "stale", "unknown"]
              },
              "input_cost_per_1m": { "type": "number" },
              "output_cost_per_1m": { "type": "number" },
              "cache_read_cost_per_1m": { "type": "number" },
              "image_tokens_max": {
                "type": "integer",
                "minimum": 0,
                "description": "v1.2: maximum number of tokens one image is billed as (e.g. DeepSeek V4-Flash-Vision tokenizes an image up to 384 tokens, charged at the model's normal token price)."
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
